{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malsignature-static",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "malsignature.com/*", "zone_name": "malsignature.com" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
