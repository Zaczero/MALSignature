{
  "name": "malsignature",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/build.ts && bun --watch src/server.ts",
    "preview:static": "bun run build && wrangler dev --assets \"${PUBLIC_DIRECTORY:-dist}\" --ip 127.0.0.1 --port 3001",
    "build": "bun run scripts/build.ts",
    "deploy:static": "bun run build && wrangler deploy --assets \"${PUBLIC_DIRECTORY:-dist}\"",
    "start": "bun src/server.ts",
    "ranking": "bun scripts/import-ranking.ts",
    "activity": "bun scripts/import-activity.ts",
    "prune": "bun scripts/prune.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@sentry/browser": "^11.7.0",
    "@sentry/bun": "^11.7.0",
    "entities": "^8.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "wrangler": "^4.149.0"
  }
}
